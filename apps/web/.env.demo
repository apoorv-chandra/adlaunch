# ─────────────────────
# AdLaunch DEMO MODE environment
# No external accounts needed -- just copy this to .env.local
# ─────────────────────

# Enables mock data and skips auth

NEXT_PUBLIC_DEMO_MODE=true

# Not used in demo mode -- stubbed out so Next.js doesn't complain
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_stub
CLERK_SECRET_KEY=sk_test_stub
NEXT_PUBLIC_API_URL=http://localhost:8787

# -------------------------------------------------------------
# To switch to full mode:
#  1. Remove NEXT_PUBLIC_DEMO_MODE or set it to false
#  2. Fill in real values from:
#     - NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY  --> clerk.com
#     - CLERK_SECRET_KEY                   --> clerk.com
#     - NEXT_PUBLIC_API_URL                --> your API host
